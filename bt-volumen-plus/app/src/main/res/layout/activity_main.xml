<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="32dp">

        <!-- Dispositivo conectado -->
        <TextView style="@style/SectionTitle" android:text="@string/section_device" />

        <TextView
            android:id="@+id/txtDevice"
            style="@style/Body"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/txtDeviceType" style="@style/Hint" />

        <TextView
            android:id="@+id/txtEngine"
            style="@style/Hint"
            android:layout_marginTop="6dp" />

        <Switch
            android:id="@+id/switchMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/master_switch"
            android:textSize="16sp" />

        <!-- Perfil -->
        <TextView style="@style/SectionTitle" android:text="@string/section_profile" />

        <TextView style="@style/Hint" android:text="@string/profile_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnDeleteProfile"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_profile" />
        </LinearLayout>

        <Switch
            android:id="@+id/switchProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/profile_enabled" />

        <!-- Volumen -->
        <TextView style="@style/SectionTitle" android:text="@string/section_volume" />

        <TextView android:id="@+id/txtBoost" style="@style/Body" android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBoost"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="40" />

        <TextView style="@style/Hint" android:text="@string/boost_hint" />

        <CheckBox
            android:id="@+id/checkLimiter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/limiter" />

        <CheckBox
            android:id="@+id/checkAutoVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/auto_volume" />

        <TextView android:id="@+id/txtAutoVolume" style="@style/Body" />

        <SeekBar
            android:id="@+id/seekAutoVolume"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="90" />

        <!-- Ecualizador -->
        <TextView style="@style/SectionTitle" android:text="@string/section_eq" />

        <TextView style="@style/Hint" android:text="@string/eq_hint" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/presetContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/eqContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Modo -->
        <TextView style="@style/SectionTitle" android:text="@string/section_mode" />

        <RadioGroup
            android:id="@+id/radioMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioGlobal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/mode_global" />

            <RadioButton
                android:id="@+id/radioSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/mode_session" />
        </RadioGroup>

        <TextView style="@style/Hint" android:text="@string/mode_hint" />

        <!-- Guía -->
        <TextView style="@style/SectionTitle" android:text="@string/section_guide" />

        <TextView style="@style/Body" android:text="@string/guide_intro" />

        <TextView style="@style/Body" android:layout_marginTop="12dp" android:textStyle="bold" android:text="@string/guide_1_title" />
        <TextView style="@style/Body" android:text="@string/guide_1" />
        <Button android:id="@+id/btnDevOptions" style="@style/GuideButton" android:text="@string/guide_1_button" />

        <TextView style="@style/Body" android:layout_marginTop="12dp" android:textStyle="bold" android:text="@string/guide_2_title" />
        <TextView style="@style/Body" android:text="@string/guide_2" />

        <TextView style="@style/Body" android:layout_marginTop="12dp" android:textStyle="bold" android:text="@string/guide_3_title" />
        <TextView style="@style/Body" android:text="@string/guide_3" />
        <Button android:id="@+id/btnSound" style="@style/GuideButton" android:text="@string/guide_3_button" />

        <TextView style="@style/Body" android:layout_marginTop="12dp" android:textStyle="bold" android:text="@string/guide_4_title" />
        <TextView style="@style/Body" android:text="@string/guide_4" />

        <TextView style="@style/Body" android:layout_marginTop="12dp" android:textStyle="bold" android:text="@string/guide_5_title" />
        <TextView style="@style/Body" android:text="@string/guide_5" />
        <Button android:id="@+id/btnBluetooth" style="@style/GuideButton" android:text="@string/guide_5_button" />

        <TextView style="@style/Body" android:layout_marginTop="12dp" android:textStyle="bold" android:text="@string/guide_6_title" />
        <TextView style="@style/Body" android:text="@string/guide_6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnBattery" style="@style/GuideButton" android:layout_marginEnd="8dp" android:text="@string/guide_6_battery" />
            <Button android:id="@+id/btnAutostart" style="@style/GuideButton" android:text="@string/guide_6_autostart" />
        </LinearLayout>

        <TextView style="@style/Hint" android:layout_marginTop="20dp" android:text="@string/disclaimer" />
    </LinearLayout>
</ScrollView>
